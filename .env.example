# ── LLM ─────────────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=optional_not_required_for_the_default_flow
# Google retires models often — change these if you see 404 NOT_FOUND in the logs.
GEMINI_MODEL=gemini-3.5-flash
GEMMA_MODEL=gemma-4-31b-it
# Optional local fallback (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434

# ── GitHub ──────────────────────────────────────────────────────────────────
# Webhook signature secret. Any random string; use the SAME value in the GitHub webhook.
GITHUB_WEBHOOK_SECRET=change_me_to_a_random_string
# OAuth App (GitHub → Settings → Developer settings → OAuth Apps).
#   Homepage URL:  http://localhost:5173
#   Callback URL:  http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=your_oauth_client_id
GITHUB_CLIENT_SECRET=your_oauth_client_secret
# Fallback token used only when nobody is signed in (optional, needs `repo` scope).
GITHUB_PAT=
# Public URL of your tunnel (e.g. https://xyz.a.pinggy.link). Needed only so the
# "Watch" button can create the push webhook automatically.
PUBLIC_URL=
# Where the dashboard runs (used for the OAuth redirect).
APP_URL=http://localhost:5173

# ── Storage ─────────────────────────────────────────────────────────────────
# ChromaDB patch memory. A relative path is fine.
CHROMADB_PATH=./chroma_data

# ── Behaviour ───────────────────────────────────────────────────────────────
# Set to 1 to SIMULATE pull requests instead of opening real ones on GitHub.
ARCANE_DRY_RUN=0
